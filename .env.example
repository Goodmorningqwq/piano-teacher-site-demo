# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Leave these unset and the site still runs, serving the bundled
# placeholder content from src/lib/fallback-content.ts. The /admin
# panel needs them.
#
# The anon key is a public, browser-safe key — row-level security is what
# protects the data. Never put the service_role key in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute site origin, used for canonical + hreflang tags. Must be the
# real domain (not a preview URL) or search engines will index the wrong
# address. Update this when you move to a custom domain.
VITE_SITE_URL=https://your-domain.com
